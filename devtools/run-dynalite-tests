"""Run every pinned Dynalite module in its own temporary backend namespace.

Build the desired backend first. This runner delegates provisioning, TLS, IAM
and cleanup to run-tikv-tests, preserves failing exits, and aggregates only
complete, internally consistent reports. It never runs npm test (which modifies
upstream sources via lint --fix). See docs/testing-dynalite.md.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent


def aggregate(reports: list[dict], exit_codes: dict[str, int]) -> dict:
    """Do not silently turn setup failures, missing files or bad counts green."""
    total = dict(tests=0, passes=0, failures=0, pending=0)
    modules = []
    invalid = []
    for name, code in exit_codes.items():
        matches = [row for row in reports if row['suite'] == name]
        if len(matches) != 1:
            invalid.append(name)
            continue
        report = matches[0]
        stats = report['stats']
        expected_code = 1 if stats['failures'] else 0
        if (not report.get('valid') or code != expected_code
                or stats['tests'] != stats['passes'] + stats['failures'] + stats['pending']
                or any(len(report[key]) != stats[count] for key, count in
                       [('passes', 'passes'), ('failures', 'failures'), ('pending', 'pending')])):
            invalid.append(name)
        for key in total:
            total[key] += stats[key]
        modules.append(dict(suite=name, **{key: stats[key] for key in total}))
    if len(reports) != len(exit_codes) or not exit_codes:
        invalid.append('report inventory')
    return dict(totals=total, modules=modules, invalid=invalid,
                exit_code=2 if invalid else (1 if total['failures'] else 0))


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--checkout', type=Path, required=True)
    parser.add_argument('--binary', type=Path, required=True)
    parser.add_argument('--output-dir', type=Path, required=True)
    parser.add_argument('--backend', choices=['tikv', 'sqlite'], default='tikv')
    parser.add_argument('--pd-endpoints', default='127.0.0.1:2379')
    parser.add_argument('--suite', action='append', help='One module basename; repeat to select several')
    args = parser.parse_args()
    checkout = args.checkout.resolve()
    binary = args.binary.resolve()
    output = args.output_dir.resolve()
    # Raw lifecycle logs can contain temporary credentials. Keep them local.
    os.umask(0o077)
    output.mkdir(parents=True, exist_ok=True)
    available = sorted(p.stem for p in (checkout / 'test').glob('*.js') if p.stem != 'helpers')
    suites = args.suite or available
    if not suites or len(set(suites)) != len(suites) or any(name not in available for name in suites):
        parser.error('Select distinct module names from the pinned checkout')
    if any((output / f'{suite}.json').exists() for suite in suites):
        parser.error('Use a fresh output directory; existing reports must not be mixed with this run')
    reports = []
    exit_codes = {}
    for suite in suites:
        report_path = output / f'{suite}.json'
        command = [sys.executable, str(ROOT / 'devtools/run-tikv-tests'), '--no-build',
                   '--binary', str(binary), '--backend', args.backend,
                   '--pd-endpoints', args.pd_endpoints, '--throttling', 'false',
                   '--artifacts-dir', str(output / f'{suite}-server'), '--command', '--',
                   'node', str(ROOT / 'devtools/dynalite_adapter.cjs'), '--checkout', str(checkout),
                   '--suite', suite, '--output', str(report_path)]
        with (output / f'{suite}.log').open('w') as log:
            result = subprocess.run(command, cwd=ROOT, stdout=log, stderr=subprocess.STDOUT)
        exit_codes[suite] = result.returncode
        if report_path.exists():
            report = json.loads(report_path.read_text())
            reports.append(dict(report, suite=suite))
        (output / 'exit-codes.json').write_text(json.dumps(exit_codes, indent=2) + '\n')
        print(f'{suite}: exit {result.returncode}', flush=True)
    summary = aggregate(reports, exit_codes)
    binary_hash = hashlib.sha256()
    with binary.open('rb') as binary_file:
        for chunk in iter(lambda: binary_file.read(1024 * 1024), b''):
            binary_hash.update(chunk)
    summary.update(backend=args.backend, throttling=False,
                   source_revision=subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True).strip(),
                   upstream_revision=subprocess.check_output(['git', '-C', str(checkout), 'rev-parse', 'HEAD'], text=True).strip(),
                   binary_sha256=binary_hash.hexdigest())
    (output / 'summary.json').write_text(json.dumps(summary, indent=2) + '\n')
    print(json.dumps(summary['totals']))
    return summary['exit_code']


if __name__ == '__main__':
    raise SystemExit(main())
